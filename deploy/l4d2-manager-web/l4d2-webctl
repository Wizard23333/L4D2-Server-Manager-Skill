def safe_zip_member(name):
    normalized = name.replace("\\", "/")
    parts = Path(normalized).parts
    if normalized.startswith("/") or ".." in parts:
        return None
    if normalized in {"manifest.json", "packages.json"}:
        return normalized
    if normalized.startswith("addons/") and len(parts) == 2 and ADDON_RE.match(parts[1]):
        return normalized
    return None


def import_export_zip(staged_filename):
    staged = staged_upload_path(staged_filename)
    ADDONS_DIR.mkdir(parents=True, exist_ok=True)
    imported = []
    try:
        with zipfile.ZipFile(staged) as archive:
            names = archive.namelist()
            if "manifest.json" not in names or "packages.json" not in names:
                fail("zip is not an L4D2 manager export")
            manifest = json.loads(archive.read("manifest.json").decode("utf-8"))
            if manifest.get("format") != "l4d2-manager-web-export":
                fail("unsupported export manifest")
            addon_names = [name for name in names if name.replace("\\", "/").startswith("addons/")]
            if not addon_names:
                fail("export contains no VPK files")
            for name in names:
                if not safe_zip_member(name):
                    fail(f"zip contains unsupported path: {name}")
            for name in addon_names:
                filename = Path(name).name
                destination = ADDONS_DIR / filename
                if destination.exists() or (DISABLED_ADDONS_DIR / filename).exists():
                    fail(f"target already exists: {filename}")
                emit("stage", stage="copying", message=f"Importing {filename}")
                DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)
                temp_destination = DOWNLOAD_DIR / job_temp_name(filename)
                try:
                    with archive.open(name) as source, open(temp_destination, "wb") as target:
                        shutil.copyfileobj(source, target)
                    assert_vpk_file(temp_destination)
                    extract_map_package(temp_destination, display_name=filename)
                    shutil.copy2(temp_destination, destination)
                    chown_steam(destination)
                finally:
                    cleanup_download_target(temp_destination)
                imported.append(filename)
    except zipfile.BadZipFile:
        fail("invalid zip file")
    emit("message", message="imported " + ", ".join(imported))


