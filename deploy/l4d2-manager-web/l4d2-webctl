def restart_room_target(target):
    services = {"room1": ["l4d2"], "room2": ["l4d2_2"], "all": ["l4d2", "l4d2_2"]}
    if target not in services:
        fail("usage: l4d2-webctl restart-room <room1|room2|all>")
    for service in services[target]:
        subprocess.run(["/usr/bin/systemctl", "restart", service], check=True)
    emit("message", message=f"restarted {target}")


def run_vpk_verify(path):
    if not VPK_EXTRACTOR.is_file():
        raise RuntimeError(f"VPK extractor missing: {VPK_EXTRACTOR}")
    result = subprocess.run(
        ["/usr/bin/python3", str(VPK_EXTRACTOR), "--verify", str(path)],
        check=False,
        capture_output=True,
        text=True,
        timeout=600,
    )
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout or "VPK verification failed").strip())


def verify_downloaded_vpk(path):
    try:
        with open(path, "rb") as handle:
            data = handle.read(4)
    except OSError:
        raise RuntimeError("downloaded file is missing")
    if data != b"\x34\x12\xaa\x55":
        raise RuntimeError("downloaded file is not a VPK")
    run_vpk_verify(path)


INSTALL_VERIFY_ATTEMPTS = 3


def install_workshop(kind, workshop_id):
    if kind not in {"map", "mod"}:
        fail("kind must be map or mod")
    if not WORKSHOP_ID_RE.match(workshop_id):
        fail("invalid workshop id")
    ADDONS_DIR.mkdir(parents=True, exist_ok=True)
    DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)

    details = fetch_workshop_details(workshop_id)
    title = safe_title(details.get("title", "workshop_item"))
    destination = ADDONS_DIR / f"{kind}_{workshop_id}_{title}.vpk"
    # Stable per-item temp name (no job_id prefix) so a re-run can resume a
    # previously interrupted partial download via HTTP Range.
    download_target = DOWNLOAD_DIR / f"resume_workshop_{workshop_id}.vpk"
    file_size = int(details.get("file_size") or 0)
    if file_size > 0:
        try:
            free_bytes = shutil.disk_usage(DOWNLOAD_DIR).free
        except OSError:
            free_bytes = None
        if free_bytes is not None and free_bytes < file_size:
            fail(f"not enough disk space: need {file_size} bytes but only {free_bytes} free")
    try:
        emit("stage", stage="preparing", message=f"Downloading {details.get('title', workshop_id)}")
        last_error = None
        for attempt in range(1, INSTALL_VERIFY_ATTEMPTS + 1):
            if attempt > 1:
                cleanup_download_target(download_target)
                emit("stage", stage="downloading", message=f"Re-downloading after verification failure (attempt {attempt}/{INSTALL_VERIFY_ATTEMPTS})")
            download_file(details["file_url"], download_target, expected_size=file_size)
            emit("stage", stage="verifying", message=f"Verifying {destination.name}")
            try:
                verify_downloaded_vpk(download_target)
                last_error = None
                break
            except RuntimeError as exc:
                last_error = exc
                if attempt < INSTALL_VERIFY_ATTEMPTS:
                    time.sleep(min(2 ** (attempt - 1), 8))
                    continue
        if last_error is not None:
            cleanup_download_target(download_target)
            fail(f"VPK verification failed after {INSTALL_VERIFY_ATTEMPTS} attempts: {last_error}")

        if kind == "map":
            extract_map_package(download_target, display_name=destination.name)

        shutil.copy2(download_target, destination)
        chown_steam(destination)

        emit("message", message=f"installed {destination.name}")
    finally:
        cleanup_download_target(download_target)


def fetch_gamemaps_details(gamemaps_id):
    if not GAMEMAPS_ID_RE.match(gamemaps_id):
        fail("invalid GameMaps id")
    url = f"https://www.gamemaps.com/details/{gamemaps_id}"
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            final_host = urllib.parse.urlparse(response.geturl()).netloc.lower()
            if final_host not in GAMEMAPS_HOSTS:
                fail(f"GameMaps details redirected to unsupported host: {final_host}")
            text = response.read(512 * 1024).decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        fail(f"GameMaps details lookup failed: HTTP {exc.code}")
    except urllib.error.URLError as exc:
        fail(f"GameMaps details lookup failed: {exc}")

    title_match = re.search(r"<h1[^>]*>\s*([^<]+)", text, re.IGNORECASE)
    file_match = re.search(r"([A-Za-z0-9_. -]+\.vpk)", text, re.IGNORECASE)
    links = []
    for match in re.finditer(r'href=["\']([^"\']+)["\']', text, re.IGNORECASE):
        href = match.group(1)
        if "download" not in href.lower() and ".vpk" not in href.lower():
            continue
        absolute = urllib.parse.urljoin(url, href)
        host = urllib.parse.urlparse(absolute).netloc.lower()
        if host in GAMEMAPS_HOSTS:
            links.append(absolute)
    links.append(f"https://www.gamemaps.com/download/{gamemaps_id}")
    return {
        "title": title_match.group(1).strip() if title_match else f"gamemaps_{gamemaps_id}",
        "filename": file_match.group(1).strip() if file_match else f"gamemaps_{gamemaps_id}.vpk",
        "links": list(dict.fromkeys(links)),
    }


