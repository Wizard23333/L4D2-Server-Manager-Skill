def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def emit(event, **fields):
    payload = {"event": event}
    payload.update(fields)
    print(json.dumps(payload, ensure_ascii=False), flush=True)


def read_null_string(handle):
    data = []
    while True:
        char = handle.read(1)
        if not char or char == b"\x00":
            break
        data.append(char)
    return b"".join(data).decode("utf-8", errors="ignore")


def vpk_maps(vpk_path):
    maps = set()
    try:
        with open(vpk_path, "rb") as handle:
            header = handle.read(8)
            if len(header) != 8:
                return maps
            signature, version = struct.unpack("<II", header)
            if signature != 0x55AA1234:
                return maps
            tree_size_data = handle.read(4)
            if len(tree_size_data) != 4:
                return maps
            if version == 2:
                handle.read(16)
            header_size = 12 if version == 1 else 28
            handle.seek(header_size)
            while True:
                extension = read_null_string(handle)
                if not extension:
                    break
                while True:
                    path = read_null_string(handle)
                    if not path:
                        break
                    while True:
                        filename = read_null_string(handle)
                        if not filename:
                            break
                        entry_data = handle.read(18)
                        if len(entry_data) != 18:
                            return maps
                        _crc, preload_bytes, _archive_index, _entry_offset, _entry_size, _term = struct.unpack("<IHHIIH", entry_data)
                        handle.read(preload_bytes)
                        if extension.lower() == "bsp" and path.lower() == "maps":
                            maps.add(filename.lower().replace(" ", "_"))
    except OSError:
        return set()
    return maps


def vpk_entries(vpk_path):
    entries = []
    try:
        with open(vpk_path, "rb") as handle:
            header = handle.read(8)
            if len(header) != 8:
                return entries
            signature, version = struct.unpack("<II", header)
            if signature != 0x55AA1234:
                return entries
            tree_size_data = handle.read(4)
            if len(tree_size_data) != 4:
                return entries
            if version == 2:
                handle.read(16)
            header_size = 12 if version == 1 else 28
            handle.seek(header_size)
            while True:
                extension = read_null_string(handle)
                if not extension:
                    break
                while True:
                    path = read_null_string(handle)
                    if not path:
                        break
                    while True:
                        filename = read_null_string(handle)
                        if not filename:
                            break
                        entry_data = handle.read(18)
                        if len(entry_data) != 18:
                            return entries
                        _crc, preload_bytes, archive_index, _entry_offset, entry_size, _term = struct.unpack("<IHHIIH", entry_data)
                        handle.read(preload_bytes)
                        path_name = "" if path in (" ", ".") else path
                        entry_name = f"{path_name}/{filename}.{extension}" if path_name else f"{filename}.{extension}"
                        entries.append({
                            "name": entry_name.replace("\\", "/"),
                            "archive_index": archive_index,
                            "size": preload_bytes + entry_size,
                        })
    except OSError:
        return []
    return entries


def safe_extracted_path(entry_name):
    relative = Path(entry_name.replace("\\", "/"))
    if relative.is_absolute() or ".." in relative.parts:
        return None
    if not relative.parts or relative.parts[0].lower() not in ALLOWED_EXTRACT_ROOTS:
        return None
    target = (GAME_DIR / relative).resolve()
    try:
        target.relative_to(GAME_DIR.resolve())
    except ValueError:
        return None
    return target


def available_maps():
    maps = {path.stem for path in MAPS_DIR.glob("*.bsp")}
    for vpk in ADDONS_DIR.glob("*.vpk"):
        maps.update(vpk_maps(vpk))
    return maps


def current_default_maps():
    maps = set()
    for script in ROOMS.values():
        try:
            text = script.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        match = re.search(r"(?:^|\s)\+map\s+(\S+)", text)
        if match:
            maps.add(match.group(1).lower())
    return maps


def set_default_map(room, map_name):
    if room not in ROOMS:
        fail("unknown room")
    if not MAP_RE.match(map_name):
        fail("invalid map name")
    if map_name not in available_maps():
        fail("map is not installed")

    script = ROOMS[room]
    text = script.read_text(encoding="utf-8", errors="replace")
    updated, count = re.subn(r"(?<=\s)\+map\s+\S+", f"+map {map_name}", text, count=1)
    if count != 1:
        fail("script does not contain one +map parameter")

    backup = script.with_name(f"{script.name}.bak-{time.strftime('%Y%m%d-%H%M%S')}")
    shutil.copy2(script, backup)
    script.write_text(updated, encoding="utf-8")
    print(f"updated {script} to {map_name}; backup {backup}")


def safe_title(value):
    value = value.strip() or "workshop_item"
    value = re.sub(r"[^A-Za-z0-9_.-]+", "_", value)
    value = value.strip("._-")
    return (value or "workshop_item")[:80]


def chown_steam(path):
    subprocess.run(["/usr/bin/chown", "-R", "steam:steam", str(path)], check=False)


def open_with_retries(request, *, timeout, attempts=4, label="request"):
    last_error = None
    for attempt in range(1, attempts + 1):
        try:
            return urllib.request.urlopen(request, timeout=timeout)
        except urllib.error.HTTPError:
            raise
        except (urllib.error.URLError, http.client.RemoteDisconnected, TimeoutError, OSError) as exc:
            last_error = exc
            if attempt == attempts:
                break
            time.sleep(min(2 ** (attempt - 1), 8))
    fail(f"{label} failed after {attempts} attempts: {last_error}")


def fetch_workshop_details(workshop_id):
    data = urllib.parse.urlencode(
        {"itemcount": "1", "publishedfileids[0]": workshop_id}
    ).encode("utf-8")
    request = urllib.request.Request(
        "https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/",
        data=data,
        headers={
            "User-Agent": "L4D2Manager/0.1",
            "Accept": "application/json",
            "Connection": "close",
        },
        method="POST",
    )
    with open_with_retries(request, timeout=30, label="Steam API lookup") as response:
        payload = json.loads(response.read().decode("utf-8"))
    details = payload.get("response", {}).get("publishedfiledetails", [{}])[0]
    if str(details.get("result")) != "1":
        fail(f"Steam API returned result {details.get('result', 'unknown')}")
    file_url = details.get("file_url")
    if not file_url or not file_url.startswith(("http://", "https://")):
        fail("Steam API did not return a downloadable file_url")
    return details


DOWNLOAD_ATTEMPTS = 4


def _download_once(url, tmp, allowed_hosts, expected, resume_from):
    headers = {"User-Agent": "L4D2Manager/0.1"}
    if resume_from > 0:
        headers["Range"] = f"bytes={resume_from}-"
    request = urllib.request.Request(url, headers=headers)
    response = urllib.request.urlopen(request, timeout=60)
    try:
        final_url = response.geturl()
        if allowed_hosts:
            host = urllib.parse.urlparse(final_url).netloc.lower()
            if host not in allowed_hosts:
                fail(f"download redirected to unsupported host: {host}")
        status = getattr(response, "status", None) or response.getcode()
        content_length = int(response.headers.get("Content-Length") or 0)
        if resume_from > 0 and status == 206:
            mode = "ab"
            downloaded = resume_from
            total = content_length + resume_from if content_length else 0
        else:
            mode = "wb"
            downloaded = 0
            total = content_length
        display_total = expected or total
        last_emit = 0
        emit("progress", stage="downloading", downloaded=downloaded, total=display_total, message="Download started")
        with open(tmp, mode) as handle:
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                handle.write(chunk)
                downloaded += len(chunk)
                now = time.monotonic()
                if now - last_emit >= 0.5 or (display_total and downloaded >= display_total):
                    emit(
                        "progress",
                        stage="downloading",
                        downloaded=downloaded,
                        total=display_total,
                        message="Downloading",
                    )
                    last_emit = now
        return downloaded, total
    finally:
        response.close()


def download_file(url, destination, allowed_hosts=None, expected_size=0, attempts=DOWNLOAD_ATTEMPTS):
    tmp = destination.with_suffix(destination.suffix + ".part")
    expected = int(expected_size or 0)
    last_error = None
    for attempt in range(1, attempts + 1):
        resume_from = tmp.stat().st_size if (expected > 0 and tmp.is_file()) else 0
        if resume_from and resume_from >= expected:
            resume_from = 0
        if resume_from == 0 and tmp.exists():
            tmp.unlink()
        if attempt > 1:
            emit(
                "progress",
                stage="downloading",
                downloaded=resume_from,
                total=expected,
                message=f"Retrying download (attempt {attempt}/{attempts})",
            )
        try:
            downloaded, total = _download_once(url, tmp, allowed_hosts, expected, resume_from)
            if expected and downloaded != expected:
                raise IOError(f"download incomplete: received {downloaded} of expected {expected} bytes")
            if not expected and total and downloaded != total:
                raise IOError(f"download incomplete: received {downloaded} of {total} bytes")
            if not expected and not total:
                emit("message", message="warning: server did not report size; relying on VPK structure verification")
            tmp.replace(destination)
            emit("progress", stage="downloaded", downloaded=downloaded, total=(expected or total), message="Download finished")
            return
        except SystemExit:
            if tmp.is_file():
                tmp.unlink()
            raise
        except urllib.error.HTTPError as exc:
            last_error = exc
            if tmp.is_file():
                tmp.unlink()
            if attempt < attempts:
                time.sleep(min(2 ** (attempt - 1), 8))
                continue
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError, OSError) as exc:
            last_error = exc
            if attempt < attempts:
                time.sleep(min(2 ** (attempt - 1), 8))
                continue
    if tmp.is_file():
        tmp.unlink()
    fail(f"Workshop file download failed after {attempts} attempts: {last_error}")


def cleanup_download_target(destination):
    for path in (destination, destination.with_suffix(destination.suffix + ".part")):
        try:
            if path.is_file():
                path.unlink()
        except OSError:
            pass


def job_temp_name(name):
    job_id = os.environ.get("L4D2_WEB_JOB_ID", "")
    if JOB_ID_RE.match(job_id):
        return f"{job_id}_{name}"
    return name


def extract_map_package(destination, display_name=None):
    if not VPK_EXTRACTOR.is_file():
        fail(f"VPK extractor missing: {VPK_EXTRACTOR}")
    label = display_name or destination.name
    emit("stage", stage="extracting", message=f"Extracting {label}")
    result = subprocess.run(
        ["/usr/bin/python3", str(VPK_EXTRACTOR), str(destination), str(GAME_DIR)],
        check=False,
        capture_output=True,
        text=True,
        timeout=600,
    )
    if result.returncode != 0:
        fail(result.stderr or result.stdout or "VPK extraction failed")
    for name in ("maps", "missions", "materials", "models", "sound", "scripts"):
        path = GAME_DIR / name
        if path.exists():
            chown_steam(path)
    emit("stage", stage="extracted", message=f"Extracted {label}")


def safe_extract_member_path(member_name):
    relative = Path(member_name.replace("\\", "/"))
    if relative.is_absolute() or ".." in relative.parts:
        return None
    parts = relative.parts
    if not parts:
        return None
    if parts[0] not in {"addons", "cfg"}:
        for index, part in enumerate(parts):
            if part in {"addons", "cfg"}:
                relative = Path(*parts[index:])
                break
        else:
            return None
    target = (GAME_DIR / relative).resolve()
    try:
        target.relative_to(GAME_DIR.resolve())
    except ValueError:
        return None
    return target


def extract_tar_addons(archive_path):
    with tarfile.open(archive_path) as archive:
        for member in archive.getmembers():
            target = safe_extract_member_path(member.name)
            if target is None:
                continue
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                continue
            if not member.isfile():
                continue
            source = archive.extractfile(member)
            if source is None:
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            with source, open(target, "wb") as handle:
                shutil.copyfileobj(source, handle)


