            destination = SOURCEMOD_DIR / item["path"]
            emit("stage", stage="downloading", message=f"Installing {plugin_id}")
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.exists() and destination.stat().st_size > 0:
                emit("message", message=f"{destination.name} already installed")
            elif item.get("api"):
                download_github_content(item["api"], destination)
            else:
                download_raw_asset(item["url"], destination)
            chown_steam(destination)
            if destination.suffix == ".smx":
                installed.append(destination.name)
        emit("message", message="installed server plugins: " + ", ".join(installed))
        return

    archive_path = download_stack_archive("wyxls")
    installed = []
    with zipfile.ZipFile(archive_path) as archive:
        for plugin_id, candidates in PLUGIN_STACK["wyxls"]["plugins"].items():
            emit("stage", stage="extracting", message=f"Installing {plugin_id}")
            installed.append(install_candidate_plugin_from_zip(archive, plugin_id, candidates))
        for name in archive.namelist():
            normalized = name.replace("\\", "/")
            lower = normalized.lower()
            if "/sourcemod/configs/" not in lower or normalized.endswith("/"):
                continue
            base = Path(normalized).name.lower()
            if any(token in base for token in ("advert", "kill", "infected", "hp")):
                relative = normalized.split("/sourcemod/", 1)[1]
                install_zip_member(archive, name, SOURCEMOD_DIR / relative)
    emit("message", message="installed server plugins: " + ", ".join(installed))


