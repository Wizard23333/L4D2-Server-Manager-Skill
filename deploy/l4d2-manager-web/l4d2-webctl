def download_stack_archive(name):
    info = PLUGIN_STACK[name]
    DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)
    suffix = ".tar.gz" if info.get("kind") == "tar" else ".zip"
    target = DOWNLOAD_DIR / job_temp_name(f"{name}{suffix}")
    emit("stage", stage="downloading", message=f"Downloading {name}")
    download_file(info["url"], target)
    if info.get("kind") == "tar":
        marker = target.read_bytes()
        if len(marker) < 256 and marker.endswith(b".tar.gz"):
            archive_name = marker.decode("utf-8", errors="strict").strip()
            archive_url = urllib.parse.urljoin(info["url"].rsplit("/", 1)[0] + "/", archive_name)
            target = DOWNLOAD_DIR / job_temp_name(archive_name)
            emit("stage", stage="downloading", message=f"Downloading {name} archive")
            download_file(archive_url, target)
    return target


def download_raw_asset(url, destination):
    tmp = destination.with_suffix(destination.suffix + ".tmp")
    if tmp.exists():
        tmp.unlink()
    result = subprocess.run(
        [
            "/usr/bin/curl",
            "-fL",
            "--connect-timeout",
            "15",
            "--max-time",
            "60",
            "--retry",
            "3",
            "--retry-delay",
            "2",
            "-o",
            str(tmp),
            url,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=240,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or f"failed to download {url}")[-2000:])
    tmp.replace(destination)


def download_github_content(api_url, destination):
    tmp = destination.with_suffix(destination.suffix + ".tmp")
    if tmp.exists():
        tmp.unlink()
    request = urllib.request.Request(api_url, headers={"User-Agent": "l4d2-manager-web"})
    with open_with_retries(request, timeout=30, label="GitHub content download") as response:
        payload = json.loads(response.read().decode("utf-8"))
    if payload.get("encoding") != "base64" or "content" not in payload:
        fail(f"unexpected GitHub content response for {api_url}")
    tmp.write_bytes(base64.b64decode(payload["content"]))
    tmp.replace(destination)


