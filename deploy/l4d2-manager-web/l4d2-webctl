    destination.parent.mkdir(parents=True, exist_ok=True)
    with archive.open(member_name) as source, open(destination, "wb") as target:
        shutil.copyfileobj(source, target)
    chown_steam(destination)


def install_left4dhooks():
    archive_path = download_stack_archive("left4dhooks")
    emit("stage", stage="extracting", message="Installing Left4DHooks")
    installed = []
    with zipfile.ZipFile(archive_path) as archive:
        for name in archive.namelist():
            normalized = name.replace("\\", "/")
            lower = normalized.lower()
            if "/sourcemod/" not in lower or normalized.endswith("/"):
                continue
            relative = normalized.split("/sourcemod/", 1)[1]
            if not relative or relative.startswith("../"):
                continue
            install_zip_member(archive, name, SOURCEMOD_DIR / relative)
            installed.append(relative)
    if not (SM_PLUGINS_DIR / "left4dhooks.smx").exists() and not (SM_DISABLED_DIR / "left4dhooks.smx").exists():
        fail("Left4DHooks archive did not contain left4dhooks.smx")
    emit("message", message=f"installed Left4DHooks files: {len(installed)}")


def find_zip_plugin(archive, candidates):
    lowered = {candidate.lower(): candidate for candidate in candidates}
    for name in archive.namelist():
        base = Path(name).name.lower()
        if base in lowered:
            return name, lowered[base]
    return None, ""


def compile_source_plugin(source_path, output_path):
    spcomp = SOURCEMOD_DIR / "scripting" / "spcomp"
    if not spcomp.exists():
        fail(f"cannot compile {source_path.name}: spcomp is missing")
    result = subprocess.run(
        [str(spcomp), str(source_path), "-o", str(output_path)],
        check=False,
        capture_output=True,
        text=True,
        timeout=60,
    )
    if result.returncode != 0:
        fail((result.stderr or result.stdout or f"failed to compile {source_path.name}")[-2000:])
    chown_steam(output_path)


def install_candidate_plugin_from_zip(archive, plugin_id, candidates):
    member, filename = find_zip_plugin(archive, candidates)
    if member:
        install_zip_member(archive, member, SM_PLUGINS_DIR / filename)
        return filename
    source_candidates = [Path(candidate).with_suffix(".sp").name for candidate in candidates]
    source_member, source_name = find_zip_plugin(archive, source_candidates)
    if not source_member:
        fail(f"could not find a prebuilt or source plugin for {plugin_id}")
    temp_dir = DOWNLOAD_DIR / job_temp_name(f"{plugin_id}_src")
    temp_dir.mkdir(parents=True, exist_ok=True)
    source_path = temp_dir / source_name
    install_zip_member(archive, source_member, source_path)
    output_name = Path(candidates[0]).name
    compile_source_plugin(source_path, SM_PLUGINS_DIR / output_name)
    return output_name


